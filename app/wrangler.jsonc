{
  // App (assets de dist/) + API (/api/*) sur Cloudflare Workers, données dans D1.
  // dist/_headers (copié depuis public/) ajoute COOP/COEP → Stockfish multicœur dans le navigateur.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chess-drill",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    // database_id : à remplacer par l'identifiant renvoyé par « wrangler d1 create chess-drill »
    { "binding": "DB", "database_name": "chess-drill", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "vars": { "GH_REPO": "mattvar00/chess-drill", "GH_WORKFLOW": "analyse.yml" },
  // secrets (wrangler secret put) : APP_TOKEN, GH_TOKEN
  "observability": { "enabled": true }
}
